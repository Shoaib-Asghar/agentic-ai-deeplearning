# DeepLearning.AI "Agentic AI" Course Environment Configuration
# Instructions:
# 1. Make a copy of this file and rename it to `.env`
# 2. Add your actual API keys into `.env` (never commit your `.env` to git)

# Primary LLM API Keys (aisuite & direct SDKs)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Tool & Search Keys (Used in planning & research agent modules)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Local/Docker Database URL (defaults to SQLite if not using PostgreSQL)
DATABASE_URL=sqlite:///./agent_tasks.db
